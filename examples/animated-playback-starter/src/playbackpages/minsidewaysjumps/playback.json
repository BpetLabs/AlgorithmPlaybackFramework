{
  "controls": [
    {
      "id": "obstacles", "type": "grid", "rows": 3, "cols": 5, "emptyItemText": "0",
      "rowLabels": ["1", "2", "3"], "columnLabels": ["0", "1", "2", "3", "4"],
      "batches": [{ "step": 0, "gridItems": [
        { "row": 0, "col": 1, "value": "", "backgroundColor": "Gray" },
        { "row": 1, "col": 2, "value": "", "backgroundColor": "Gray" },
        { "row": 2, "col": 3, "value": "", "backgroundColor": "Gray" }
      ] }]
    },
    {
      "id": "code", "type": "staticText",
      "staticValue": "def min_sideways_jumps(obstacles: list[int]) -> int:\n    # Minimum jumps to reach the current position in each\n    # lane.\n    jumps = [1, 0, 1]\n\n    for obstacle in obstacles:\n        if obstacle != 0:\n            jumps[obstacle - 1] = float(\"inf\")\n\n        # Jump sideways from the cheapest available lane.\n        minimum = min(jumps)\n\n        for lane in range(3):\n            if lane + 1 != obstacle:\n                jumps[lane] = min(jumps[lane], minimum + 1)\n\n    return min(jumps)",
      "batches": [
        { "step": 0, "scrollBottom": 0 },
        { "step": 1, "highlightLines": [{ "range": "1-17", "borderColor": "Orange" }, { "range": "4", "backgroundColor": "Highlight.Pause" }, { "range": "5-17", "backgroundColor": "Highlight.Unused" }] },
        { "step": 2, "clearHighlights": [{ "range": "4-7,9-14", "backgroundColor": true }], "highlightLines": [{ "range": "1-3", "backgroundColor": "Highlight.Unused" }, { "range": "8", "backgroundColor": "Highlight.False" }, { "range": "15", "backgroundColor": "Highlight.Pause" }] },
        { "step": 3, "highlightLines": [{ "range": "4-12", "backgroundColor": "Highlight.Unused" }] },
        { "step": 5, "clearHighlights": [{ "range": "6-7,15-16", "backgroundColor": true }], "highlightLines": [{ "range": "8", "backgroundColor": "Highlight.Pause" }, { "range": "14", "backgroundColor": "Highlight.Unused" }] },
        { "step": 6, "clearHighlights": [{ "range": "8-12,14", "backgroundColor": true }], "highlightLines": [{ "range": "6-7,16", "backgroundColor": "Highlight.Unused" }, { "range": "15", "backgroundColor": "Highlight.Pause" }] },
        { "step": 7, "highlightLines": [{ "range": "8-12", "backgroundColor": "Highlight.Unused" }] },
        { "step": 8, "clearHighlights": [{ "range": "6-7,15-16", "backgroundColor": true }], "highlightLines": [{ "range": "8", "backgroundColor": "Highlight.Pause" }, { "range": "14", "backgroundColor": "Highlight.Unused" }] },
        { "step": 9, "clearHighlights": [{ "range": "8-12,14", "backgroundColor": true }], "highlightLines": [{ "range": "6-7,16", "backgroundColor": "Highlight.Unused" }, { "range": "15", "backgroundColor": "Highlight.Pause" }] },
        { "step": 10, "highlightLines": [{ "range": "8-12", "backgroundColor": "Highlight.Unused" }] },
        { "step": 11, "clearHighlights": [{ "range": "6-7,15-16", "backgroundColor": true }], "highlightLines": [{ "range": "8", "backgroundColor": "Highlight.Pause" }, { "range": "14", "backgroundColor": "Highlight.Unused" }] },
        { "step": 12, "clearHighlights": [{ "range": "8-12,14", "backgroundColor": true }], "highlightLines": [{ "range": "6-7,16", "backgroundColor": "Highlight.Unused" }, { "range": "15", "backgroundColor": "Highlight.Pause" }] },
        { "step": 13, "highlightLines": [{ "range": "8-12", "backgroundColor": "Highlight.Unused" }] },
        { "step": 14, "clearHighlights": [{ "range": "6-7,9-12", "backgroundColor": true }], "highlightLines": [{ "range": "8", "backgroundColor": "Highlight.False" }] },
        { "step": 15, "highlightLines": [{ "range": "6-12", "backgroundColor": "Highlight.Unused" }] },
        { "step": 17, "clearHighlights": [{ "range": "15-16", "backgroundColor": true }], "highlightLines": [{ "range": "14", "backgroundColor": "Highlight.Unused" }, { "range": "17", "backgroundColor": "Highlight.Pause" }] },
        { "step": 18, "highlightLines": [{ "range": "1-17", "borderColor": "Pink" }, { "range": "13,15-16", "backgroundColor": "Highlight.Unused" }, { "range": "17", "backgroundColor": "Highlight.Return" }] },
        { "step": 19, "clearHighlights": [{ "range": "1-17" }], "scrollBottom": 0 }
      ]
    },
    {
      "id": "playbyplay", "type": "text", "initialItemCount": 1,
      "batches": [
        { "step": 0, "setValues": [{ "index": 0, "input": { "value": "This function finds the minimum number of sideways jumps needed to move through three lanes while avoiding obstacles.\n\nIt can be used to plan a lowest-cost lane path in O(n) time and O(1) extra space." } }] },
        { "step": 1, "setValues": [{ "index": 0, "input": { "value": "Command: min_sideways_jumps([0, 1, 2, 3, 0])\n\njumps will be initialized to [1, 0, 1]." } }] },
        { "step": 2, "setValues": [{ "index": 0, "input": { "value": "For obstacle 0, minimum is 0.\n\njumps[0] will remain 1." } }] },
