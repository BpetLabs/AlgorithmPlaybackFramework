        { "step": 13, "setValues": [{ "index": 1, "input": { "borderColor": "" } }, { "index": 2, "input": { "value": "lane | 1", "borderColor": "Orange" } }] },
        { "step": 14, "setValues": [{ "index": 0, "input": { "value": "obstacle | 0", "borderColor": "Orange" } }, { "index": 2, "input": { "value": "lane | 0", "borderColor": "Orange" } }] },
        { "step": 15, "setValues": [{ "index": 0, "input": { "borderColor": "" } }, { "index": 2, "input": { "value": "lane | 1", "borderColor": "Orange" } }] },
