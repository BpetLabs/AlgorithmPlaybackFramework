        { "step": 17, "setValues": [{ "index": 2, "input": { "borderColor": "" } }] },
        { "step": 18, "tailDeletes": { "count": 3, "now": true } }
      ]
    },
    {
      "id": "jumps", "type": "array", "initialItemCount": 3, "render": { "visible": false },
      "batches": [
