{
  "name": "algorithm-playback-framework",
  "version": "0.1.0",
  "description": "React components and utilities for building step-by-step algorithm visualizations.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpet-dev/AlgorithmPlaybackFramework.git"
  },
  "bugs": {
    "url": "https://github.com/bpet-dev/AlgorithmPlaybackFramework/issues"
  },
  "homepage": "https://github.com/bpet-dev/AlgorithmPlaybackFramework#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "framer-motion": ">=11 <13",
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "framer-motion": "^12.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
