    {
      "id": "code",
      "type": "staticText",
      "staticValue": "def min_sideways_jumps(obstacles: list[int]) -> int:\n    # Minimum jumps to reach the current position in each lane.\n    jumps = [1, 0, 1]\n\n    for obstacle in obstacles:\n        if obstacle != 0:\n            jumps[obstacle - 1] = float(\"inf\")\n\n        # Jump sideways from the cheapest available lane.\n        minimum = min(jumps)\n\n        for lane in range(3):\n            if lane + 1 != obstacle:\n                jumps[lane] = min(jumps[lane], minimum + 1)\n\n    return min(jumps)",
