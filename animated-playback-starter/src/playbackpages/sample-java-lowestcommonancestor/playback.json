      "type": "staticText",
      "staticValue": "public class LowestCommonAncestor {\n    public static class TreeNode {\n        int value;\n        TreeNode left;\n        TreeNode right;\n\n        TreeNode(int value) {\n            this(value, null, null);\n        }\n\n        TreeNode(int value, TreeNode left, TreeNode right) {\n            this.value = value;\n            this.left = left;\n            this.right = right;\n        }\n    }\n\n    public static TreeNode lowestCommonAncestor(\n        TreeNode root,\n        TreeNode first,\n        TreeNode second\n    ) {\n        if (root == null || root == first || root == second) {\n            return root;\n        }\n\n        TreeNode left = lowestCommonAncestor(\n            root.left,\n            first,\n            second\n        );\n        TreeNode right = lowestCommonAncestor(\n            root.right,\n            first,\n            second\n        );\n\n        // Targets were found in separate branches.\n        if (left != null && right != null) {\n            return root;\n        }\n\n        return left != null ? left : right;\n    }\n}",
